## 4.2 Dengue Cases by Various Factors

::: panel-tabset
#### Age Group



```{r}
#| code-fold: true
#| code-summary: "Show Code"
dengue_aggregated_age <- dengue_daily_sf %>%
    group_by(Age_Group, geometry) %>%
    summarize(Count = n(), .groups = "drop")

tm_shape(dengue_aggregated_age) + 
    tm_bubbles(fill = "Age_Group",
               size = "Count",
               col = "black",
               lwd = 1)
```



#### Gender



```{r}
#| code-fold: true
#| code-summary: "Show Code"
dengue_aggregated_gender <- dengue_daily_sf %>%
    group_by(Gender, geometry) %>%
    summarize(Count = n(), .groups = "drop")

tm_shape(dengue_aggregated_gender) + 
    tm_bubbles(fill = "Gender",
               size = "Count",
               col = "black",
               lwd = 1)
```



#### Serotype



```{r}
#| code-fold: true
#| code-summary: "Show Code"

# Excluding data with missing Serotype
dengue_aggregated_serotype <- dengue_daily_sf %>%
    filter(!is.na(Serotype)) %>% 
    group_by(Serotype, geometry) %>%
    summarize(Count = n(), .groups = "drop")

tm_shape(dengue_aggregated_serotype) + 
    tm_bubbles(fill = "Serotype",
               size = "Count",
               col = "black",
               lwd = 1)
```



#### Imported Case



```{r}
#| code-fold: true
#| code-summary: "Show Code"
dengue_aggregated_imported <- dengue_daily_sf %>%
    group_by(Imported_Case, geometry) %>%
    summarize(Count = n(), .groups = "drop")

tm_shape(dengue_aggregated_imported) + 
    tm_bubbles(fill = "Imported_Case",
               size = "Count",
               col = "black",
               lwd = 1)
```



#### County



```{r}
#| code-fold: true
#| code-summary: "Show Code"
dengue_aggregated_county <- dengue_daily_sf %>%
    group_by(Residential_County_City, geometry) %>%
